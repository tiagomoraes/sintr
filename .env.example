# sintr configuration.
#
# `make setup` copies this file to `.env` and fills every empty secret with a
# fresh random value. `.env` is ignored by git; never commit it. The same file
# configures `make dev`, `make test` and the self-host stack (`make selfhost-up`).

# ----- Application -----

# The public URL people use to reach sintr. Cookies are marked Secure when it
# starts with https://. Locally both `make dev` and `make selfhost-up` serve
# on port 3000, so the default works for either (not both at once).
SINTR_URL=http://localhost:3000

# selfhost or saas. Same code either way; this flag is the switch.
SINTR_MODE=selfhost

# open or closed. On a personal self-host, create your account, then set this
# to closed so nobody else can sign up.
SINTR_SIGNUP=open

# debug, info, warn or error. Logs never contain diary content.
SINTR_LOG_LEVEL=info

# ----- Secrets (generated by make setup) -----

# Signs session cookies. At least 32 characters.
SINTR_AUTH_SECRET=

# The master key (KEK) that wraps every per-user data key: 32 random bytes,
# base64. Without it no diary can be read. Back it up separately from the
# database; a backup of both together defeats the encryption.
SINTR_MASTER_KEY=

# Stored next to each wrapped key, so a future rotation can tell keys apart.
SINTR_MASTER_KEY_ID=k1

# ----- Database -----

POSTGRES_USER=sintr
POSTGRES_PASSWORD=
POSTGRES_DB=sintr

# Host port of the development database (make dev, make test, make migrate).
SINTR_DEV_DB_PORT=54329

# Connection string for development. make setup writes it from the values
# above. The self-host stack builds its own, pointing at its own database.
DATABASE_URL=

# ----- Self-host (docker/compose.yaml) -----

# What Caddy serves. ":80" is plain HTTP on any host name, for local use. For
# a public server put the bare domain (diary.example.com): Caddy then obtains
# a TLS certificate by itself. Set SINTR_URL to https://that-domain as well.
SINTR_SITE_ADDRESS=:80

# Interface and ports Caddy publishes on the host. Keep 127.0.0.1 unless the
# machine is meant to be reached from the network; a public server with a
# domain uses SINTR_BIND=0.0.0.0, SINTR_HTTP_PORT=80, SINTR_HTTPS_PORT=443.
SINTR_BIND=127.0.0.1
SINTR_HTTP_PORT=3000
SINTR_HTTPS_PORT=3443

# Optional. A subnet for the stack's private network, for hosts where Docker
# reports "all predefined address pools have been fully subnetted" (a VPN that
# routes 10.0.0.0/8 or 172.16.0.0/12 does this). Example: 10.253.17.0/24.
SINTR_DOCKER_SUBNET=
