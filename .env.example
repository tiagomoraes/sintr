# sintr configuration.
#
# `make setup` (or the first `make selfhost-up`) copies this file to `.env` and
# fills every empty secret with a fresh random value. `.env` is ignored by git;
# never commit it. The same file configures `make dev`, `make test` and the
# self-host stack.

# ----- Application -----

# The public URL people use to reach sintr. Cookies are marked Secure when it
# starts with https://. Locally both `make dev` and `make selfhost-up` serve
# on port 3000, so the default works for either (not both at once).
SINTR_URL=http://localhost:3000

# selfhost or saas. Same code either way; this flag is the switch.
SINTR_MODE=selfhost

# open or closed. On a personal self-host, create your account, then set this
# to closed so nobody else can sign up.
SINTR_SIGNUP=open

# debug, info, warn or error. Logs never contain diary content.
SINTR_LOG_LEVEL=info

# ----- Secrets (generated by make setup) -----

# Signs session cookies. At least 32 characters.
SINTR_AUTH_SECRET=

# The master key (KEK) that wraps every per-user data key: 32 random bytes,
# base64. Without it no diary can be read. Back it up separately from the
# database; a backup of both together defeats the encryption.
SINTR_MASTER_KEY=

# Stored next to each wrapped key, so a future rotation can tell keys apart.
SINTR_MASTER_KEY_ID=k1

# ----- Database -----

POSTGRES_USER=sintr
POSTGRES_PASSWORD=
POSTGRES_DB=sintr

# Host port of the development database (make dev, make test, make migrate).
# Left empty, make setup picks one between 54000 and 54899 from the checkout's
# path, so several checkouts can run side by side.
SINTR_DEV_DB_PORT=

# Connection string for development. make setup writes it from the values
# above. The self-host stack builds its own, pointing at its own database.
DATABASE_URL=

# ----- Email (optional) -----

# An SMTP server for the approved report to the therapist, the "report ready"
# notice, password reset and email confirmation. Left empty, email is off:
# reports can still be downloaded, and the app says that nothing is sent.
# Any provider that offers SMTP works (your mail host, Fastmail, Postmark,
# Amazon SES, a relay on your network). See docs/SELFHOST.md.
SINTR_SMTP_HOST=
# 587 with starttls (the default), or 465 with tls. "none" is plain text, for
# a relay on the same machine or network only (refused in saas mode).
SINTR_SMTP_PORT=587
SINTR_SMTP_SECURITY=starttls
SINTR_SMTP_USER=
SINTR_SMTP_PASSWORD=
# The sender, as the recipient sees it. Required with SINTR_SMTP_HOST.
# Example: sintr <diary@example.com>
SINTR_EMAIL_FROM=

# ----- Practices (therapists receiving their patients' reports) -----

# The seats of a practice that has no plan of its own: a whole number, or
# "unlimited". Left empty: unlimited on a self-host, one on the hosted offer
# (SINTR_MODE=saas), until a grant (`make practice-plan`) or a subscription.
SINTR_PRACTICE_SEATS=
# The name of that plan, as a practice sees it. Left empty: "Self-hosted", or
# "Free" in saas mode.
SINTR_PRACTICE_PLAN=

# ----- The house assistant (optional) -----

# One provider, one model and one key for everyone on this installation, so
# nobody has to bring a key of their own (they still can, in Settings). Left
# empty, as on a typical self-host, each person uses their own key. All or
# nothing: the provider and the model, plus the key for anthropic and google,
# or the address for openai_compatible. The key is a server secret: it is
# never stored in the database, never shown, never logged. See docs/OPS.md.
# anthropic, google or openai_compatible.
SINTR_HOUSE_PROVIDER=
# Required for openai_compatible (OpenAI, OpenRouter, a LiteLLM gateway on
# your own network). For anthropic and google the official address is used.
SINTR_HOUSE_BASE_URL=
# The model's name, as the provider writes it. Example: claude-haiku-5-5
SINTR_HOUSE_MODEL=
SINTR_HOUSE_KEY=
# Who people are told receives what they write, in Settings. Left empty: the
# provider's name, or the gateway's host name.
SINTR_HOUSE_NAME=

# The plan of a person without a subscription or a grant of their own: free
# (the default, as on the hosted offer), personal, or unlimited (a family
# server that pays its own house key). Only the house assistant is counted.
SINTR_PERSON_PLAN=free

# ----- Payments (optional, Stripe) -----

# Left empty, payments are off: plans come from SINTR_PERSON_PLAN and from
# grants (make person-plan, make practice-plan). All three of the key, the
# webhook secret and at least one price turn them on. See docs/OPS.md.
SINTR_STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint at SINTR_URL/api/billing/webhook.
SINTR_STRIPE_WEBHOOK_SECRET=
# Recurring prices: Personal (one a month) and one practice seat (a month).
SINTR_STRIPE_PRICE_PERSONAL=
SINTR_STRIPE_PRICE_PRACTICE_SEAT=

# ----- Self-host (docker/compose.yaml) -----

# What Caddy serves. ":80" is plain HTTP on any host name, for local use. For
# a public server put the bare domain (diary.example.com): Caddy then obtains
# a TLS certificate by itself. Set SINTR_URL to https://that-domain as well.
SINTR_SITE_ADDRESS=:80

# Interface and ports Caddy publishes on the host. Keep 127.0.0.1 unless the
# machine is meant to be reached from the network; a public server with a
# domain uses SINTR_BIND=0.0.0.0, SINTR_HTTP_PORT=80, SINTR_HTTPS_PORT=443.
SINTR_BIND=127.0.0.1
SINTR_HTTP_PORT=3000
SINTR_HTTPS_PORT=3443

# Optional. A subnet for the stack's private network, for hosts where Docker
# reports "all predefined address pools have been fully subnetted" (a VPN that
# routes 10.0.0.0/8 or 172.16.0.0/12 does this). Example: 10.253.17.0/24.
SINTR_DOCKER_SUBNET=

# ----- Tests only -----

# 1 replaces every assistant provider with a scripted, offline one (a
# provider still has to be saved in Settings). The end-to-end tests set it so
# they never reach a real model, and it is handy to rehearse the app without
# a key. Never set it on a real installation; it is refused in saas mode, and
# the app says on screen when it is on.
# SINTR_FAKE_AGENT=0

# Another address for the Stripe API, for the end-to-end tests' fake Stripe.
# Never set it on a real installation (refused in saas mode).
# SINTR_STRIPE_API_URL=

# A directory where emails are written as files instead of being sent. The
# end-to-end tests set it; never set it on a real installation (refused in
# saas mode).
# SINTR_EMAIL_OUTBOX=

# The Chromium that prints reports to PDF. The Docker image sets its own;
# for make dev and make test, Playwright's (installed by make setup) is used.
# SINTR_CHROMIUM_PATH=
